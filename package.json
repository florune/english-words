{
  "name": "word-pocket",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && tsc -p functions/tsconfig.json && vite build",
    "preview": "vite preview",
    "build:words": "node scripts/build-word-list.mjs scripts/wordfreq-en-25000-log.json public/data/words.json",
    "build:phonetics": "node scripts/build-phonetics.mjs scripts/cmudict.dict public/data/words.json public/data/phonetics.json",
    "build:translations": "node scripts/build-translations.mjs scripts/ecdict.csv public/data/words.json public/data/translations.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "vue": "^3.5.18",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vue-tsc": "^3.0.5"
  }
}
